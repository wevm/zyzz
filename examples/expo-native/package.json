  "config": {
    "site": false
  },
  "dependencies": {
    "expo": "57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "zyzz": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "typescript": "6.0.3"
  }
}
