{
  "name": "typestyle",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Type-safe style props compiled to static CSS.",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.19.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/Compiler.d.ts",
      "default": "./dist/Compiler.js"
    },
    "./vite": {
      "types": "./dist/Vite.d.ts",
      "default": "./dist/Vite.js"
    },
    "./build": {
      "types": "./dist/Build.d.ts",
      "default": "./dist/Build.js"
    }
  },
  "bin": {
    "typestyle": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "check": "prettier --check .",
    "format": "prettier --write .",
    "dev": "vite --config examples/vite/vite.config.ts",
    "build:example": "vite build --config examples/vite/vite.config.ts",
    "build:library": "node dist/cli.js examples/library/src --out-dir examples/library/dist",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "csstype": "^3.2.3",
    "magic-string": "^1.2.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^26.4.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
