{
  "scripts": {
    "bench:render": "zile && vp test run --config bench/Render.config.ts --no-file-parallelism",
    "bench:types": "node scripts/type-benches.ts",
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "check": "vp check --fix",
    "check:at-rules": "node scripts/at-rule-conformance.ts && node scripts/at-rule-acceptance.ts",
    "check:at-rules:full": "node scripts/at-rule-conformance.ts && node scripts/at-rule-acceptance.ts --require-full",
    "check:at-rules:legacy-full": "node scripts/at-rule-conformance.ts --require-full",
    "check:at-rules:rendering": "node scripts/at-rule-conformance.ts && node scripts/at-rule-acceptance.ts --require-rendering",
    "check:at-rules:targets": "node scripts/at-rule-conformance.ts && node scripts/at-rule-acceptance.ts --require-targets",
    "check:css": "node scripts/css-conformance.ts",
    "check:css:full": "node scripts/css-conformance.ts --require-full",
    "check:types": "tsc",
    "dev": "zile dev",
    "test": "vp test",
    "update:at-rules": "node scripts/at-rule-conformance.ts --update",
    "update:css": "node scripts/css-conformance.ts --update",
    "update:types": "node scripts/type-benches.ts --update"
  },
  "devDependencies": {
    "@ark/attest": "0.56.3",
    "@babel/core": "^7.29.7",
    "@changesets/cli": "^3.0.2",
    "@pandacss/node": "^1.12.1",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "@types/babel__core": "^7.20.5",
    "@types/css-tree": "3.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "^0.28.2",
    "mdn-data": "2.35.0",
    "pdf-lib": "1.17.1",
    "pkg-pr-new": "^0.0.88",
    "playwright": "^1.63.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vite-plus": "0.2.2",
    "zile": "0.0.30"
  },
  "packageManager": "pnpm@11.19.0",
  "[!start-pkg]": "",
  "name": "zyzz",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "description": "Type-safe style props compiled to static CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "!src/**/*.bench-d.ts",
    "!src/**/*.bench.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.test.ts"
  ],
  "sideEffects": [
    "./src/reset.css",
    "./dist/reset.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "src": "./src/compiler/index.ts",
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./node": {
      "src": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./reset.css": {
      "src": "./src/reset.css",
      "default": "./dist/reset.css"
    },
    "./runtime": {
      "src": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./vite": {
      "src": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./web": {
      "src": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@oxc-project/types": "0.148.0",
    "css-tree": "3.2.1",
    "lightningcss": "^1.33.0",
    "magic-string": "^1.2.3",
    "oxc-parser": "0.148.0",
    "oxc-walker": "1.1.1"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
