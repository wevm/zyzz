{
  "name": "typestyle",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Type-safe style props compiled to static CSS.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "zile --project tsconfig.build.json",
    "check": "vp check",
    "check:types": "tsc --noEmit",
    "dev": "zile dev --project tsconfig.build.json",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "5.9.3",
    "vite-plus": "0.2.2",
    "zile": "0.0.30"
  },
  "main": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false
}
