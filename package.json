{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "check": "vp check --fix",
    "check:types": "tsc",
    "dev": "zile dev",
    "test": "vp test"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@changesets/cli": "^3.0.2",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@pandacss/node": "^1.12.1",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.10.1",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "pkg-pr-new": "^0.0.88",
    "playwright": "^1.63.0",
    "quickjs-emscripten": "^0.32.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite-plus": "0.2.2",
    "zile": "0.0.30"
  },
  "packageManager": "pnpm@11.19.0",
  "[!start-pkg]": "",
  "name": "zyzz",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "description": "Type-safe style props compiled to static CSS.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "!src/**/*.bench.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "src": "./src/compiler/index.ts",
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./node": {
      "src": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./runtime": {
      "src": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./web": {
      "src": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    }
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@oxc-project/types": "0.148.0",
    "magic-string": "^1.2.3",
    "oxc-parser": "0.148.0",
    "oxc-walker": "1.1.1"
  }
}
