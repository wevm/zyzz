{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zyzz-site",
  // Semantic results for documentation search. Cloudflare rejects a binding to a missing instance, so this stays disabled until `zyzz-docs` exists.
  // "ai_search": [
  //   {
  //     "binding": "AI_SEARCH",
  //     "instance_name": "zyzz-docs",
  //     "remote": true,
  //   },
  // ],
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/entry.server.ts",
  "observability": {
    "enabled": true,
  },
}
