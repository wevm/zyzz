{
  "@color-profile": {
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules",
    "syntax": "@color-profile <dashed-ident> { src: <url>; rendering-intent: <intent>; }"
  },
  "@color-profile/rendering-intent": {
    "context": "@color-profile",
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules"
  },
  "@color-profile/src": {
    "context": "@color-profile",
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules"
  },
  "@custom-media": {
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules",
    "syntax": "@custom-media <dashed-ident> [ <media-query-list> | true | false ];"
  },
  "@font-feature-values/@annotation": {
    "context": "@font-feature-values",
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules"
  },
  "@font-feature-values/@character-variant": {
    "context": "@font-feature-values",
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules"
  },
  "@font-feature-values/@ornaments": {
    "context": "@font-feature-values",
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules"
  },
  "@font-feature-values/@styleset": {
