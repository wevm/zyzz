    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules"
  },
  "@font-feature-values/font-display": {
    "context": "@font-feature-values",
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules"
  },
  "@function": {
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules",
    "syntax": "@function <dashed-ident>(<parameters>) [returns <syntax>]? { <function-body> }"
  },
  "@function/result": {
    "context": "@function",
    "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules"
