{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "zyzz": ["./src/index.ts"],
      "zyzz/babel": ["./src/babel/index.ts"],
      "zyzz/compiler": ["./src/compiler/index.ts"],
      "zyzz/metro": ["./src/metro/index.ts"],
      "zyzz/metro/transformer": ["./src/metro/transformer.ts"],
      "zyzz/next": ["./src/next/index.ts"],
      "zyzz/next/loader": ["./src/next/loader.ts"],
      "zyzz/node": ["./src/node/index.ts"],
      "zyzz/react-native": ["./src/react-native/index.ts"],
      "zyzz/runtime": ["./src/runtime/index.ts"],
      "zyzz/themes/default": ["./src/themes/default.ts"],
      "zyzz/vite": ["./src/vite/index.ts"],
      "zyzz/web": ["./src/web/index.ts"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "types": ["node", "vite-plus/test/globals"],
    "verbatimModuleSyntax": true
  },
  "exclude": [
    ".fixture-*/**",
    "bench/results/**",
    "bench/native/app",
    "dist",
    "examples/*/dist",
    "examples/expo-native",
    "examples/next-react",
    "examples/start-react",
    "node_modules",
    "test-results"
  ]
}
