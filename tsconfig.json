{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "zyzz": ["./src/index.ts"],
      "zyzz/compiler": ["./src/compiler/index.ts"],
      "zyzz/node": ["./src/node/index.ts"],
      "zyzz/runtime": ["./src/runtime/index.ts"],
      "zyzz/vite": ["./src/vite/index.ts"],
      "zyzz/web": ["./src/web/index.ts"]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "types": ["node", "vite-plus/test/globals"],
    "verbatimModuleSyntax": true
  },
  "exclude": [
    ".fixture-*/**",
    "bench/results/**",
    "dist",
    "node_modules",
    "test-results"
  ]
}
