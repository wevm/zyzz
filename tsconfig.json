{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": ["src", "examples/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules", "examples/**/dist"]
}
